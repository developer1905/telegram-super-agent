# ============================================================
#  TELEGRAM SUPER-AGENT — Muhit O'zgaruvchilari Namunasi
#  Bu faylni nusxalab ".env" deb nomlang va to'ldiring.
# ============================================================

# --- Telegram Bot (BotFather dan oling) ---
BOT_TOKEN=your_bot_token_here

# --- Admin Telegram ID (bitta, raqam formatida) ---
ADMIN_ID=123456789

# --- Kunlik hisobot kanaliga ID (masalan: -1001234567890) ---
LOG_CHANNEL_ID=-1001234567890

# --- Telethon Userbot (my.telegram.org dan oling) ---
API_ID=12345678
API_HASH=your_api_hash_here
# StringSession qiymatini olish uchun: python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c=TelegramClient(StringSession(), API_ID, API_HASH); c.start(); print(c.session.save())"
USERBOT_SESSION=your_string_session_here
# Userbot telefon raqami (xalqaro format, masalan: +998901234567)
USERBOT_PHONE=+998901234567

# --- Google Gemini API (aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouter API (openrouter.ai/keys) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Ixtiyoriy: Midjourney API Kaliti (GoAPI, ImagineAPI) ---
# Agar kiritilmasa, bot avtomatik ravishda 100% BEPUL cheksiz Midjourney v6 / Flux dvigatelidan foydalanadi
MIDJOURNEY_API_KEY=
MIDJOURNEY_API_URL=https://api.goapi.ai/api/v1/task

# --- Ixtiyoriy: Watermark matni ---
WATERMARK_TEXT=© SuperAgent

# --- Email Agent (IMAP & SMTP - Gmail, Mail.ru, Yandex) ---
# Gmail uchun 2-Step Verification yoqib, App Passwords bo'limidan 16 xonali parol oling
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_CHECK_INTERVAL=15

# --- Supabase (Doimiy Xotira / Long-term Memory) ---
# supabase.com dan loyiha ochib oling (ixtiyoriy, kiritilmasa avtomatik SQLite ishlaydi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- Telegram Mini App (Web App) URL ---
# Render yoki boshqa hosting URL manzili (masalan: https://superagent.onrender.com)
WEBAPP_URL=https://your-domain.onrender.com
PORT=8080
